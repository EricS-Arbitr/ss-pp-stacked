# {{ ansible_managed }}
# Malcolm's compose services use restart: "no", so nothing brings them back
# after a reboot. This unit runs Malcolm's own start/stop, which also prepare
# the keystore, bind-mount dirs and permissions, and stops the stack
# gracefully before Docker shuts down.
[Unit]
Description=Malcolm network traffic analysis stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
RequiresMountsFor={{ malcolm_install_dir }}
{% if (malcolm_host_prep_gre_mirror_enabled | default(false) | bool) and (malcolm_capture_interface | default('')) == (malcolm_host_prep_gre_mirror_iface | default('')) %}
# Live capture binds the gretap decap interface; it must exist before the
# capture containers start (and after a reboot the decap unit re-creates it).
Wants=malcolm-gre-mirror.service
After=malcolm-gre-mirror.service
{% endif %}

[Service]
Type=oneshot
RemainAfterExit=yes
User={{ malcolm_user }}
Group={{ malcolm_group }}
WorkingDirectory={{ malcolm_install_dir }}
# --profile malcolm is REQUIRED, not optional: control.py's --profile defaults to
# None, and start() only creates the opensearch keystore (which the compose
# bind-mounts, and which must exist before the opensearch container starts) when
# args.composeProfile == PROFILE_MALCOLM. Without it the keystore is never
# generated and `docker compose up` dies on the missing bind source
# (opensearch/opensearch.keystore). Matches malcolm_compose's own profile.
ExecStart=/usr/bin/python3 {{ malcolm_install_dir }}/scripts/control.py --start --quiet --profile malcolm
ExecStop=/usr/bin/python3 {{ malcolm_install_dir }}/scripts/control.py --stop --quiet --profile malcolm
TimeoutStartSec={{ malcolm_service_start_timeout }}
TimeoutStopSec={{ malcolm_service_stop_timeout }}

[Install]
WantedBy=multi-user.target
